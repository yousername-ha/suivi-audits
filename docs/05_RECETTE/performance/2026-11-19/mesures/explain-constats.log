2026-11-19 20:38:23.365 UTC [2165] suivi_app@suivi 172.19.0.3LOG:  duration: 2790.481 ms  execute <unnamed>: SELECT * FROM (
	      WITH x AS (
	        SELECT d.constat_id, d.machine_id, d.derniere_detection, (d.vu_numero >= coalesce(e.numero_complet, 0)) AS present, (CASE WHEN coalesce(m.perimetre_id,
	  (SELECT td.perimetre_id FROM vulnerabilites_tenable_depots td WHERE td.id = m.depot_id)) IS NULL THEN $1::boolean
	                ELSE grc_smsi_visible(coalesce(m.perimetre_id,
	  (SELECT td.perimetre_id FROM vulnerabilites_tenable_depots td WHERE td.id = m.depot_id)), $2::uuid) END) AS lisible
	        FROM vulnerabilites_detections d
	        JOIN vulnerabilites_machines m ON m.id = d.machine_id
	        LEFT JOIN vulnerabilites_tenable_etat e ON e.integration_id = m.integration_id
	        WHERE true),
	      pc AS (SELECT constat_id, bool_or(present) AS present FROM x GROUP BY constat_id),
	      par_constat AS (
	        SELECT x.constat_id, pc.present, count(DISTINCT x.machine_id) FILTER (WHERE x.lisible)::int AS machines,
	               max(x.derniere_detection) FILTER (WHERE x.lisible) AS derniere
	        FROM x JOIN pc ON pc.constat_id = x.constat_id
	        WHERE x.present OR NOT pc.present
	        GROUP BY x.constat_id, pc.present
	        HAVING bool_or(x.lisible))
	      SELECT c.*, p.machines, p.derniere, p.present, EXISTS (SELECT 1 FROM vulnerabilites_constat_cves cc
	  JOIN vulnerabilites_veille_cve v ON v.cve = cc.cve WHERE cc.constat_id = c.id AND v.kev_ajout IS NOT NULL) AS exploite, NOT EXISTS (SELECT 1 FROM vulnerabilites_constat_cves cc WHERE cc.constat_id = c.id) AS non_maintenu,
	        coalesce((SELECT min(dp.premiere_detection) FROM vulnerabilites_detections dp
	  WHERE dp.constat_id = c.id), c.cree_le) AS premiere,
	        EXISTS (SELECT 1 FROM vulnerabilites_constat_cves cc
	  WHERE cc.constat_id = c.id AND EXISTS (SELECT 1 FROM vulnerabilites_veille_avis a
	    WHERE a.source = 'cert-fr' AND a.nature = 'alerte' AND a.cves @> ARRAY["cc"."cve"]::text[])) AS alerte_certfr, (SELECT max(v.epss_score) FROM vulnerabilites_constat_cves cc
	  JOIN vulnerabilites_veille_cve v ON v.cve = cc.cve WHERE cc.constat_id = c.id) AS epss_veille,
	        (SELECT count(*)::int FROM vulnerabilites_constat_cves cc WHERE cc.constat_id = c.id) AS nombre_cves,
	        ARRAY(SELECT cc.cve FROM vulnerabilites_constat_cves cc WHERE cc.constat_id = c.id ORDER BY cc.cve DESC LIMIT 5)
	          AS cves,
	        coalesce(s.etat, 'nouvelle') AS suivi_etat,
	  coalesce(s.proposition, 'aucune') AS suivi_proposition, s.revue_le::text AS suivi_revue,
	  coalesce(s.version, 0) AS suivi_version, s.delai_repart_le AS suivi_repart,
	  coalesce(s.etat = 'risque_accepte' AND s.revue_le < (now() AT TIME ZONE $3)::date, false) AS suivi_revue_depassee,
	  (SELECT count(*)::int FROM vulnerabilites_suivi_actions sa WHERE sa.suivi_id = s.id) AS suivi_actions
	      FROM vulnerabilites_constats c JOIN par_constat p ON p.constat_id = c.id
	      LEFT JOIN vulnerabilites_suivis s ON s.constat_id = c.id
	      WHERE ((p.present OR s.id IS NOT NULL) AND coalesce(s.etat, 'nouvelle') IN ('nouvelle', 'a_traiter', 'en_cours')
	    AND coalesce(s.proposition, 'aucune') <> 'a_confirmer')) c
