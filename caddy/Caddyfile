# Frontal HTTPS (Caddy 2). Variables : SITE_ADDRESS, CADDY_TLS (voir .env).
{
	admin off
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	tls {$CADDY_TLS}

	encode zstd gzip

	request_body {
		max_size 60MB
	}

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy app:8080 {
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	log {
		output stdout
		format json
	}
}
