{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astra:grc:bundle-proposal:1",
  "title": "Contrat proposé : bundle de configuration (sous-ensemble du domaine)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scale"
      }
    },
    "matrices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrix"
      }
    },
    "context": {
      "$ref": "#/$defs/context"
    }
  },
  "required": [
    "schemaVersion",
    "scales",
    "matrices",
    "context"
  ],
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "numericValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "order",
        "label",
        "color"
      ]
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "dimensionKey": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "qualitative",
            "quantitative",
            "hybrid"
          ]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level"
          }
        }
      },
      "required": [
        "id",
        "familyId",
        "version",
        "dimensionKey",
        "mode",
        "levels"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rowLevelId": {
          "type": "string",
          "minLength": 1
        },
        "columnLevelId": {
          "type": "string",
          "minLength": 1
        },
        "resultLevelId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rowLevelId",
        "columnLevelId",
        "resultLevelId"
      ]
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rowScaleVersionId": {
          "type": "string",
          "minLength": 1
        },
        "columnScaleVersionId": {
          "type": "string",
          "minLength": 1
        },
        "resultScaleVersionId": {
          "type": "string",
          "minLength": 1
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      },
      "required": [
        "id",
        "rowScaleVersionId",
        "columnScaleVersionId",
        "resultScaleVersionId",
        "cells"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "studyId": {
          "type": "string",
          "minLength": 1
        },
        "organizationId": {
          "type": "string",
          "minLength": 1
        },
        "methodVersionId": {
          "type": "string",
          "minLength": 1
        },
        "configBindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "const": "synthetic-proposal"
        }
      },
      "required": [
        "id",
        "studyId",
        "organizationId",
        "methodVersionId",
        "configBindings",
        "status"
      ]
    }
  }
}
