# Suivi des audits SMSI ISO 27001 / HDS — configuration
# Copier en .env (cp .env.example .env) puis adapter. Ne jamais versionner le fichier .env.
# Aucun mot de passe ici : les secrets sont générés au premier démarrage par le service « init »
# dans DATA_DIR/secrets.

# --- Données du serveur -------------------------------------------------------
# Dossier du serveur qui contient TOUTES les données (base, secrets, certificats, rapports), hors des conteneurs.
# À préparer une fois (sudo ./scripts/preparer-donnees.sh) et à inclure dans la sauvegarde externalisée du serveur.
# Jamais dans le dossier de l'application, dans /tmp ni dans /var/lib/docker.
DATA_DIR=/srv/suivi-audits/donnees

# --- Frontal HTTPS (Caddy) -------------------------------------------------
# Nom DNS du serveur (sans https://), par exemple suivi-audits.mondomaine.local
SITE_ADDRESS=suivi-audits.example.local
# « internal » : autorité de certification interne de Caddy.
# Certificat de votre PKI : déposer fullchain.pem et privkey.pem dans ./certs puis
#   CADDY_TLS=/certs/fullchain.pem /certs/privkey.pem
CADDY_TLS=internal
# Lot A : opt-in pour les remplacements TLS depuis Administration > Système.
# 0 = .env seul ; 1 = couple web validé prioritaire tant qu'il est actif, retour .env possible.
TLS_WEB_MANAGEMENT=0
# caddy ou external : external interdit tout remplacement/retour depuis le web.
TLS_TERMINATION=caddy
# Adresse et ports d'écoute sur l'hôte (les redirections HTTP -> HTTPS supposent HTTPS_PORT=443)
BIND_ADDR=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80

# --- Application ------------------------------------------------------------
# Version publiée à installer (images ghcr.io/yousername-ha/suivi-audits-api, -web et -updater), sans le « v » :
# voir https://github.com/yousername-ha/suivi-audits/releases
APP_VERSION=3.0.0
APP_NAME="Suivi des audits SMSI"
ORG_NAME="GCS Normand'e-Santé"

# Sessions et authentification : valeurs par défaut, modifiables ensuite dans Paramètres > Sécurité
# (bornes imposées : mot de passe ≥ 12 caractères, double authentification toujours obligatoire).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=10
MFA_REQUIRED=true
PASSWORD_MIN_LENGTH=12
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Requêtes par minute et par adresse IP, toutes routes confondues (au-delà : 429). À relever si de nombreux postes
# sortent par une même adresse (traduction d'adresses).
RATE_LIMIT_PER_MINUTE=1200

# Limites (Mo) et historique des versions conservées
MAX_STATE_MB=20
MAX_UPLOAD_MB=50
STATE_HISTORY_KEEP=1000

# --- Antivirus (facultatif) -------------------------------------------------
# Activer avec : docker compose --profile antivirus up -d
#CLAMAV_HOST=clamav
#CLAMAV_PORT=3310
#CLAMAV_REQUIRED=true
