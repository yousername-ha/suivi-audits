{
  "name": "suivi-audits",
  "type": "module",
  "version": "3.0.1",
  "private": true,
  "description": "Suivi des audits SMSI ISO 27001 / HDS — GCS Normand'e-Santé",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter @suivi/shared --filter @suivi/api --filter @suivi/web run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter @suivi/shared --filter @suivi/ui --filter @suivi/api --filter @suivi/web run test",
    "dev": "docker compose -f docker-compose.dev.yml up"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
