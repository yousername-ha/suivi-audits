{
  "name": "suivi-audits",
  "type": "module",
  "version": "4.1.0",
  "private": true,
  "description": "Suivi des audits SMSI ISO 27001 / HDS — GCS Normand'e-Santé",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --filter @suivi/shared --filter @suivi/api --filter @suivi/web run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter @suivi/shared --filter @suivi/ui --filter @suivi/api --filter @suivi/web run test",
    "dev": "docker compose -f docker-compose.dev.yml up"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
