{
  "name": "@suivi/api",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "description": "API du suivi des audits SMSI (Fastify, PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "tsx --conditions=source src/openapi-cli.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@suivi/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
