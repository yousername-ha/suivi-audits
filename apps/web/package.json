{
  "name": "@suivi/web",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "description": "Interface web du suivi des audits SMSI (React, Vite, Mantine)",
  "scripts": {
    "dev": "node scripts/mantine-css-vars.ts && vite",
    "build": "node scripts/mantine-css-vars.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@suivi/shared": "workspace:*",
    "@suivi/ui": "workspace:*",
    "@tanstack/react-query": "5.104.4",
    "fflate": "0.8.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
