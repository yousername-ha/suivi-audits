    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@suivi/shared": "workspace:*",
    "@suivi/ui": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "fflate": "0.8.3",
    "qrcode-generator": "1.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
